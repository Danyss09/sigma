# =====================================================================
# SIGMA - Variables de entorno de PRODUCCION (plantilla, sin secretos)
#
#   cp .env.production.example .env.production      <- y edita los valores CAMBIAR
#
# ".env.production" NO se sube a Git (esta en .gitignore). Nunca reutilices
# las claves del .env.example del repositorio: estan publicadas.
# Para generar claves aleatorias (Git Bash o Linux):
#   openssl rand -hex 24        (contrasenas: solo letras y numeros, sin espacios)
#   openssl rand -base64 48     (secretos JWT)
# =====================================================================

# En el SERVIDOR quita el "#" de la linea siguiente (asi basta con "docker compose up -d"):
# COMPOSE_FILE=docker-compose.prod.yml

# Direccion publica (sin https://). Para probar en tu PC: localhost
DOMAIN=localhost
# Correo para avisos de vencimiento del certificado HTTPS
ACME_EMAIL=CAMBIAR@uce.edu.ec

# ---- PostgreSQL ----
POSTGRES_USER=sigma_user
POSTGRES_DB=sigma_db
POSTGRES_PASSWORD=CAMBIAR

# ---- Almacenamiento (MinIO) ----
MINIO_ROOT_USER=sigma_minio_admin
MINIO_ROOT_PASSWORD=CAMBIAR
MINIO_BUCKET=sigma-planillas
# MinIO Community ya no publica imagenes nuevas, y quay.io le cerro el acceso anonimo (sep-2026).
# Se usa el mirror de Chainguard (mismos binarios), fijado por huella digital (no publican tags
# estables gratis). El bucket lo crea el propio backend al arrancar, ya no hace falta MC_IMAGE.
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:bd014394a80898e68c149f2311fdf8d5a2c2f3bb2c33b9327ae6d02b4b065ae1

# ---- JWT ----
JWT_SECRET=CAMBIAR
JWT_REFRESH_SECRET=CAMBIAR
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ---- Imagenes (solo si las construye GitHub Actions y el servidor las descarga) ----
# REGISTRY=ghcr.io/tu_usuario_en_minusculas
# TAG=latest
